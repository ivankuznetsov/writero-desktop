# Maintainer: Writero Desktop contributors
pkgname=writero-desktop
pkgver=0.1.0
pkgrel=1
pkgdesc="Native block editor with AI writing tools and local-first documents"
arch=('x86_64' 'aarch64')
url="https://github.com/ivankuznetsov/writero-desktop"
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'libsecret' 'sqlite')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DWRITERO_BUILD_TESTS=OFF \
        -S "$pkgname-$pkgver"
    cmake --build build
}

check() {
    cmake -B build-test -G Ninja \
        -DCMAKE_BUILD_TYPE=Debug \
        -DWRITERO_BUILD_TESTS=ON \
        -S "$pkgname-$pkgver"
    cmake --build build-test
    QT_QPA_PLATFORM=offscreen ctest --test-dir build-test --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build --prefix /usr
}
